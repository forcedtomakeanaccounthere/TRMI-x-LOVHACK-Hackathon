{
  "name": "@linkroom/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "setup:playwright": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@linkroom/shared": "*",
    "@mozilla/readability": "^0.6.0",
    "@supabase/supabase-js": "^2.57.0",
    "cfb": "^1.2.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.1.0",
    "isomorphic-dompurify": "^2.26.0",
    "jsdom": "^26.1.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nanoid": "^5.1.5",
    "nodemailer": "^8.0.11",
    "playwright": "^1.64.1",
    "swagger-ui-express": "5.0.1",
    "unpdf": "^1.7.0",
    "web-push": "3.6.7",
    "yauzl": "^3.4.0",
    "zod": "^4.1.0",
    "zod-openapi": "6.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsdom": "^21.1.7",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/web-push": "3.6.4",
    "@types/yauzl": "^3.4.0",
    "postgres": "^3.4.7",
    "supertest": "^7.3.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
