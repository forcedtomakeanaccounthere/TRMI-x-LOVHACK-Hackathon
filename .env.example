# Copy to .env at the repo root (and apps/frontend/.env.local for Next.js public vars).

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Service URLs ---
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public URL of the backend; email verification links point to $API_PUBLIC_URL/api/auth/verify
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000

# --- Email (verification links, sent with nodemailer) ---
# Required in production. Empty in development = the local Supabase inbox (http://127.0.0.1:54324).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Ports ---
SERVER_PORT=4000
AI_PORT=8000

# --- AI service ---
# Tried in AI_PROVIDERS order until one succeeds; providers without a key are skipped.
AI_PROVIDERS=nvidia,gemini,mistral,anthropic
NVIDIA_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
