# Copy to .env at the repo root (and apps/frontend/.env.local for Next.js public vars).

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Service URLs ---
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public URL of the backend; email verification links point to $API_PUBLIC_URL/api/auth/verify
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000
# Shared secret between apps/backend and apps/ai (X-Internal-Token). Required in production:
# generate one with `openssl rand -hex 32` and set the same value on both hosts.
AI_INTERNAL_TOKEN=

# --- Email (verification links, sent with nodemailer) ---
# Required in production. Empty in development = the local Supabase inbox (http://127.0.0.1:54324).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Ports ---
SERVER_PORT=4000
# Headless Chromium processes the link-import fallback may run at once (default 2).
# PLAYWRIGHT_MAX_BROWSERS=2
AI_PORT=8000

# --- AI service ---
# Set to production on the AI host: it then refuses to start without AI_INTERNAL_TOKEN.
ENVIRONMENT=development
# Tried in AI_PROVIDERS order until one succeeds; providers without a key are skipped.
AI_PROVIDERS=nvidia,gemini,mistral,anthropic
NVIDIA_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Embeddings for search (POST /embed): one provider and model, no fallback, since vectors from
# different models don't compare. Uses that provider's *_API_KEY above. Without it, rooms are
# still searchable by keyword. EMBEDDING_DIM must match supabase/migrations/0011_chunks.sql;
# changing the model means re-indexing every room.
EMBEDDING_PROVIDER=nvidia
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
EMBEDDING_DIM=1024

# Moderation of Ask's questions and answers (shown to the whole room), via Mistral's moderation API
# when MISTRAL_API_KEY is set. Fails open: without a key or when the API errors, text is allowed.
MODERATION_ENABLED=true

# YouTube rooms: YouTube often blocks transcript requests from cloud hosts. Set an http(s) proxy URL
# (credentials included) to fetch through it. Without one, users can paste the transcript.
YT_PROXY_URL=
