{
  "name": "linkroom",
  "private": true,
  "packageManager": "npm@11.8.0",
  "workspaces": [
    "apps/frontend",
    "apps/backend",
    "apps/ai",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:frontend": "turbo run dev --filter=@linkroom/frontend",
    "dev:backend": "turbo run dev --filter=@linkroom/backend",
    "dev:ai": "turbo run dev --filter=@linkroom/ai",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test:unit test:integration",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e --filter=@linkroom/backend",
    "test:db": "supabase test db",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "setup:ai": "cd apps/ai && uv sync"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "husky": "9.1.7",
    "supabase": "2.120.0",
    "turbo": "^2.5.0",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=22.14"
  }
}
